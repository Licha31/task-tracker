ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
ENVIRONMENT=development
DATABASE_URL=sqlite:///./payroll_tracker.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production requires DATABASE_URL to be set to the Railway PostgreSQL connection string.
# Use none only when frontend and backend are on different sites. Production cookies are Secure.
ADMIN_COOKIE_SAMESITE=lax
